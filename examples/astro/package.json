{
  "name": "react-websocket-astro-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node server.ts",
    "typecheck": "astro check",
    "update-library": "npm --prefix ../.. run build && node -e \"require('fs').rmSync('node_modules/react-websocket', { recursive: true, force: true })\" && npm install"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "astro": "^7.3.8",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-websocket": "file:../..",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
