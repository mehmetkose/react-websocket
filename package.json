{
  "name": "react-websocket",
  "version": "3.4.0",
  "description": "Hooks-first WebSocket client for React: shared connections, auto-reconnect, typed messages, Suspense-ready",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./chaos": {
      "import": {
        "types": "./dist/chaos.d.ts",
        "default": "./dist/chaos.js"
      },
      "require": {
        "types": "./dist/chaos.d.cts",
        "default": "./dist/chaos.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:package": "npm run build && publint --strict && attw --pack . --profile node16",
    "size": "npm run build && size-limit",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "example:tornado": "vp dev examples/tornado",
    "example:tornado:server": "python3 examples/tornado/server.py",
    "example:nextjs": "npm --prefix examples/nextjs run update-library && npm --prefix examples/nextjs run dev",
    "example:hono": "npm --prefix examples/hono run update-library && npm --prefix examples/hono run dev",
    "example:astro": "npm --prefix examples/astro run update-library && npm --prefix examples/astro run dev",
    "example:remix": "npm --prefix examples/remix run update-library && npm --prefix examples/remix run dev",
    "prepublishOnly": "npm run check && npm test && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetkose/react-websocket.git"
  },
  "keywords": [
    "react",
    "websocket",
    "hooks",
    "realtime",
    "reconnect",
    "suspense"
  ],
  "author": "Mehmet Kose <mehmet@sourcream.uk> (https://sourcream.uk/)",
  "maintainers": [
    "Mehmet Kose <mehmet@sourcream.uk> (https://sourcream.uk/)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mehmetkose/react-websocket/issues"
  },
  "homepage": "https://mehmetkose.github.io/react-websocket/",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@rspress/core": "^2.0.23",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "size-limit": [
    {
      "name": "react-websocket (useWebSocket)",
      "path": "dist/index.js",
      "import": "{ useWebSocket }",
      "ignore": [
        "react"
      ],
      "limit": "3.2 kB",
      "gzip": true
    },
    {
      "name": "react-websocket/core (createWebSocket)",
      "path": "dist/core.js",
      "import": "{ createWebSocket }",
      "ignore": [
        "react"
      ],
      "limit": "2.8 kB",
      "gzip": true
    },
    {
      "name": "react-websocket (topics + state hooks)",
      "path": "dist/index.js",
      "import": "{ useWebSocketTopic, useWebSocketState, createWebSocketTopics, createWebSocketState }",
      "ignore": [
        "react"
      ],
      "limit": "1 kB",
      "gzip": true
    },
    {
      "name": "react-websocket (requests + latency)",
      "path": "dist/index.js",
      "import": "{ createWebSocketRequests, createWebSocketLatency, useWebSocketLatency }",
      "ignore": [
        "react"
      ],
      "limit": "1.5 kB",
      "gzip": true
    },
    {
      "name": "react-websocket (responder + approval hook)",
      "path": "dist/index.js",
      "import": "{ createWebSocketResponder, useAgentApproval }",
      "ignore": [
        "react"
      ],
      "limit": "1.2 kB",
      "gzip": true
    },
    {
      "name": "react-websocket/chaos (createChaosWebSocket)",
      "path": "dist/chaos.js",
      "import": "{ createChaosWebSocket }",
      "limit": "2.1 kB",
      "gzip": true
    }
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  }
}
