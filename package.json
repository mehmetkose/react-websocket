{
  "name": "react-websocket",
  "version": "3.2.0",
  "description": "Hooks-first WebSocket client for React: shared connections, auto-reconnect, typed messages, Suspense-ready",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "npm run build && publint --strict && attw --pack . --profile node16",
    "size": "npm run build && size-limit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "example": "vp dev example",
    "example:server": "python3 example/server.py",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetkose/react-websocket.git"
  },
  "keywords": [
    "react",
    "websocket",
    "hooks",
    "realtime",
    "reconnect",
    "suspense"
  ],
  "author": "Mehmet Kose <mehmet@sourcream.uk> (https://sourcream.uk/)",
  "maintainers": [
    "Mehmet Kose <mehmet@sourcream.uk> (https://sourcream.uk/)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mehmetkose/react-websocket/issues"
  },
  "homepage": "https://github.com/mehmetkose/react-websocket",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitepress": "^1.6.4",
    "vitest": "5.0.3"
  },
  "size-limit": [
    {
      "name": "react-websocket (useWebSocket)",
      "path": "dist/index.js",
      "import": "{ useWebSocket }",
      "ignore": [
        "react"
      ],
      "limit": "3 kB"
    },
    {
      "name": "react-websocket/core (createWebSocket)",
      "path": "dist/core.js",
      "import": "{ createWebSocket }",
      "ignore": [
        "react"
      ],
      "limit": "2.6 kB"
    },
    {
      "name": "react-websocket (topics + state hooks)",
      "path": "dist/index.js",
      "import": "{ useWebSocketTopic, useWebSocketState, createWebSocketTopics, createWebSocketState }",
      "ignore": [
        "react"
      ],
      "limit": "1 kB"
    },
    {
      "name": "react-websocket (requests + latency)",
      "path": "dist/index.js",
      "import": "{ createWebSocketRequests, createWebSocketLatency, useWebSocketLatency }",
      "ignore": [
        "react"
      ],
      "limit": "1.3 kB"
    }
  ],
  "overrides": {
    "@docsearch/react": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3",
    "vitepress": {
      "vite": "^5.4.21"
    }
  }
}
